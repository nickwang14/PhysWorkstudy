{
  "project_info": {
    "project_number": "${FIREBASE_PROJECT_NUMBER}",
    "project_id": "${FIREBASE_PROJECT_ID}",
    "storage_bucket": "${FIREBASE_STORAGE_BUCKET}"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "${FIREBASE_MOBILESDK_APP_ID}",
        "android_client_info": {
          "package_name": "${FIREBASE_ANDROID_PACKAGE_NAME}"
        }
      },
      "oauth_client": [
        {
          "client_id": "${FIREBASE_ANDROID_OAUTH_CLIENT_ID}",
          "client_type": "${FIREBASE_ANDROID_OAUTH_CLIENT_TYPE}",
          "android_info": {
            "package_name": "${FIREBASE_ANDROID_OAUTH_PACKAGE_NAME}",
            "certificate_hash": "${FIREBASE_ANDROID_CERTIFICATE_HASH}"
          }
        },
        {
          "client_id": "${FIREBASE_WEB_OAUTH_CLIENT_ID}",
          "client_type": "${FIREBASE_WEB_OAUTH_CLIENT_TYPE}"
        }
      ],
      "api_key": [
        {
          "current_key": "${FIREBASE_API_KEY}"
        }
      ],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": [
            {
              "client_id": "${FIREBASE_APPINVITE_OAUTH_CLIENT_ID}",
              "client_type": "${FIREBASE_APPINVITE_OAUTH_CLIENT_TYPE}"
            }
          ]
        }
      }
    }
  ],
  "configuration_version": "${FIREBASE_CONFIGURATION_VERSION}"
}