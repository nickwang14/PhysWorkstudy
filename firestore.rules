rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Granted only by a trusted Admin SDK workflow, never a profile field.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
        data.trainingGoal is string && data.trainingGoal.size() > 0 && data.trainingGoal.size() <= 100 &&
        data.fitnessLevel is string && data.fitnessLevel in ['Beginner', 'Intermediate', 'Advanced'] &&
        data.weeklyTargetWorkouts is int && data.weeklyTargetWorkouts >= 1 && data.weeklyTargetWorkouts <= 7 &&
        data.favoriteSplit is string && data.favoriteSplit.size() > 0 && data.favoriteSplit.size() <= 100 &&
        (!('weightKg' in data) || (data.weightKg is number && data.weightKg >= 20.0 && data.weightKg <= 300.0)) &&
        (!('heightCm' in data) || (data.heightCm is number && data.heightCm >= 50.0 && data.heightCm <= 260.0)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidWorkoutLog(data, userId, logId) {
      return data.logId == logId &&
        data.userId == userId &&
        data.workoutName is string && data.workoutName.size() > 0 && data.workoutName.size() <= 150 &&
        data.splitDay is string && data.splitDay.size() > 0 && data.splitDay.size() <= 100 &&
        data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 360 &&
        data.completedExercisesCount is int && data.completedExercisesCount >= 0 && data.completedExercisesCount <= 50 &&
        data.totalExercisesCount is int && data.totalExercisesCount >= 0 && data.totalExercisesCount <= 50 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        isValidTimestamp(data.completedAt) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidLessonProgress(data, userId, lessonId) {
      return data.lessonId == lessonId &&
        data.userId == userId &&
        isValidTimestamp(data.completedAt);
    }

    function isValidLessonIndex(data, lessonId) {
      return data.keys().hasOnly([
          'lessonId', 'title', 'chapterId', 'chapterTitle', 'chapterNumber',
          'subchapterId', 'subchapterTitle', 'lessonIndex', 'durationMinutes',
          'category', 'summary', 'assetPath'
        ]) && data.lessonId == lessonId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.chapterId is string && data.chapterId.size() > 0 && data.chapterId.size() <= 100 &&
        data.chapterTitle is string && data.chapterTitle.size() > 0 && data.chapterTitle.size() <= 150 &&
        data.chapterNumber is int && data.chapterNumber >= 1 && data.chapterNumber <= 20 &&
        data.subchapterId is string && data.subchapterId.size() > 0 && data.subchapterId.size() <= 100 &&
        data.subchapterTitle is string && data.subchapterTitle.size() > 0 && data.subchapterTitle.size() <= 150 &&
        data.lessonIndex is int && data.lessonIndex >= 1 && data.lessonIndex <= 50 &&
        data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 120 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
        data.summary is string && data.summary.size() > 0 && data.summary.size() <= 1000 &&
        data.assetPath is string && data.assetPath.size() > 0 && data.assetPath.size() <= 300;
    }

    function lessonExists(lessonId) {
      return exists(/databases/$(database)/documents/curriculum_lessons/$(lessonId));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['status', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['status', 'updatedBy', 'updatedAt']) &&
        data.status in ['approved', 'rejected', 'needs_improvement'] &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['authorId', 'text', 'createdAt']) &&
        data.keys().hasOnly(['authorId', 'text', 'createdAt']) &&
        data.authorId == request.auth.uid &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
        !data.text.matches('\\s*') &&
        data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if false;

      match /workout_logs/{logId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWorkoutLog(request.resource.data, userId, logId);
        allow delete: if isOwner(userId);
      }

      match /lesson_progress/{lessonId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidLessonProgress(request.resource.data, userId, lessonId);
        allow delete: if isOwner(userId);
      }
    }

    match /curriculum_lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidLessonIndex(request.resource.data, lessonId);
      allow delete: if false;

      // Review metadata is separate from bundled lesson index/publishing payloads.
      match /review/{reviewId} {
        allow read: if reviewId == 'status' && isAuthenticated();
        allow create, update: if reviewId == 'status' && isAdmin() &&
          lessonExists(lessonId) && isValidReview(request.resource.data);
        allow delete: if false;
      }

      match /comments/{commentId} {
        // Queries by ordinary users must constrain authorId to their UID.
        allow read: if isAdmin() || isOwner(resource.data.authorId);
        allow create: if isAuthenticated() && lessonExists(lessonId) &&
          isValidComment(request.resource.data);
        allow update: if false;
        allow delete: if isAdmin() || isOwner(resource.data.authorId);
      }
    }
  }
}
