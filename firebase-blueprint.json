{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing training preferences, goals, and metrics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique Firebase Authentication UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoUrl": { "type": "string", "description": "User avatar photo URL" },
        "trainingGoal": { "type": "string", "description": "Primary fitness goal" },
        "fitnessLevel": { "type": "string", "description": "Fitness experience level" },
        "weeklyTargetWorkouts": { "type": "integer", "description": "Target workout sessions per week" },
        "favoriteSplit": { "type": "string", "description": "Preferred workout split" },
        "weightKg": { "type": "number", "description": "Body weight in kilograms" },
        "heightCm": { "type": "number", "description": "Height in centimeters" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": [
        "userId",
        "email",
        "displayName",
        "trainingGoal",
        "fitnessLevel",
        "weeklyTargetWorkouts",
        "favoriteSplit",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkoutLog": {
      "title": "WorkoutLog",
      "description": "User workout session history and progress log",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "description": "Unique workout log ID" },
        "userId": { "type": "string", "description": "Owner Firebase Authentication UID" },
        "workoutName": { "type": "string", "description": "Name of completed workout" },
        "splitDay": { "type": "string", "description": "Split program day" },
        "durationMinutes": { "type": "integer", "description": "Duration of session in minutes" },
        "completedExercisesCount": { "type": "integer", "description": "Number of completed exercises" },
        "totalExercisesCount": { "type": "integer", "description": "Total scheduled exercises" },
        "notes": { "type": "string", "description": "Optional workout session notes" },
        "completedAt": { "type": "string", "format": "date-time", "description": "Completion timestamp via serverTimestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" }
      },
      "required": [
        "logId",
        "userId",
        "workoutName",
        "splitDay",
        "durationMinutes",
        "completedExercisesCount",
        "totalExercisesCount",
        "completedAt",
        "createdAt"
      ]
    },
    "CurriculumLessonIndex": {
      "title": "CurriculumLessonIndex",
      "description": "Indexed movement curriculum lesson referencing markdown asset location",
      "type": "object",
      "properties": {
        "lessonId": { "type": "string", "description": "Unique lesson ID (e.g. terminology-01)" },
        "title": { "type": "string", "description": "Title of the lesson" },
        "chapterId": { "type": "string", "description": "Parent chapter slug" },
        "chapterNumber": { "type": "integer", "description": "1-based chapter number" },
        "chapterTitle": { "type": "string", "description": "Chapter display title" },
        "subchapterId": { "type": "string", "description": "Parent subchapter slug" },
        "subchapterTitle": { "type": "string", "description": "Subchapter display title" },
        "lessonIndex": { "type": "integer", "description": "Index within subchapter" },
        "durationMinutes": { "type": "integer", "description": "Estimated duration in minutes" },
        "category": { "type": "string", "description": "Topic category name" },
        "summary": { "type": "string", "description": "Learning objective or summary" },
        "assetPath": { "type": "string", "description": "Relative asset location of markdown file" }
      },
      "required": [
        "lessonId",
        "title",
        "chapterId",
        "chapterNumber",
        "chapterTitle",
        "subchapterId",
        "subchapterTitle",
        "lessonIndex",
        "durationMinutes",
        "category",
        "summary",
        "assetPath"
      ]
    },
    "LessonProgress": {
      "title": "LessonProgress",
      "description": "User completion status and timestamp for a curriculum lesson",
      "type": "object",
      "properties": {
        "lessonId": { "type": "string", "description": "ID of the completed lesson" },
        "userId": { "type": "string", "description": "User UID who completed the lesson" },
        "completedAt": { "type": "string", "format": "date-time", "description": "Timestamp when lesson was completed" }
      },
      "required": [
        "lessonId",
        "userId",
        "completedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document storing personal settings and workout targets"
    },
    "/users/{userId}/workout_logs/{logId}": {
      "schema": "WorkoutLog",
      "description": "Subcollection of logged workout sessions for progress tracking"
    },
    "/users/{userId}/lesson_progress/{lessonId}": {
      "schema": "LessonProgress",
      "description": "Subcollection of completed lessons per user for progress tracking"
    },
    "/curriculum_lessons/{lessonId}": {
      "schema": "CurriculumLessonIndex",
      "description": "Indexed movement curriculum lessons referencing markdown file locations"
    }
  }
}
