# Local gateway runtime credentials. The gateway should read these server-side;
# never pass them into the Android APK, BuildConfig, or client requests.
EXERCISE_DB_API_KEY=YOUR_EXERCISE_DB_API_KEY
EXERCISE_DB_API_HOST=exercisedb.p.rapidapi.com

# Optional non-secret endpoint Android calls after the PhysiApp gateway is available.
EXERCISE_CATALOG_GATEWAY_URL=