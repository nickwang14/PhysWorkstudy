# Setup and security guidance: docs/firebase-and-keys.md
# Gradle reads the host directly; shared/release builds omit the private key.
# Private debug builds must opt in with -PincludeExerciseDbDevelopmentKey=true
# and exclude -x :app:packageInstallerZip. Root .env wins over process values.
# DEV ONLY: an opted-in key is compiled into the APK and extractable. Do not use a
# production provider key; production requires a separately implemented backend.
# Generate a development key through your RapidAPI account's ExerciseDB app.
EXERCISE_DB_API_KEY=YOUR_EXERCISE_DB_API_KEY
EXERCISE_DB_API_HOST=exercisedb.p.rapidapi.com
# Firebase Android client configuration (not Admin SDK credentials).
# Import an authentic downloaded JSON with npm.cmd run firebase:config:import.
# Then run npm.cmd run firebase:config to generate ignored app/google-services.json.
# All placeholders below map to app/google-services.template.json; Gradle reads
# the generated JSON, not these FIREBASE_* variables directly. Do not paste keys
# into chat. Existing .env entries take precedence over process environment.
FIREBASE_PROJECT_NUMBER=YOUR_FIREBASE_PROJECT_NUMBER
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
FIREBASE_MOBILESDK_APP_ID=YOUR_FIREBASE_MOBILESDK_APP_ID
FIREBASE_ANDROID_PACKAGE_NAME=YOUR_ANDROID_APPLICATION_ID
FIREBASE_ANDROID_OAUTH_CLIENT_ID=YOUR_ANDROID_OAUTH_CLIENT_ID
FIREBASE_ANDROID_OAUTH_CLIENT_TYPE=1
FIREBASE_ANDROID_OAUTH_PACKAGE_NAME=YOUR_ANDROID_APPLICATION_ID
FIREBASE_ANDROID_CERTIFICATE_HASH=YOUR_ANDROID_CERTIFICATE_HASH
FIREBASE_WEB_OAUTH_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID
FIREBASE_WEB_OAUTH_CLIENT_TYPE=3
FIREBASE_API_KEY=YOUR_FIREBASE_CLIENT_API_KEY
FIREBASE_APPINVITE_OAUTH_CLIENT_ID=YOUR_APPINVITE_OAUTH_CLIENT_ID
FIREBASE_APPINVITE_OAUTH_CLIENT_TYPE=3
FIREBASE_CONFIGURATION_VERSION=1
# GEMINI_API_KEY is not consumed by this app; keep private provider/admin keys
# in trusted server/tool environments, never in generated Android configuration.
