# Source textbooks are large binary reference material kept local-only.
# Keep local PDFs in theory-and-knowledge/knowledge/textbooks/; commit only approved,
# attributed text excerpts and assets. See the knowledge README for source titles.
/docs/**/*.pdf
# Rendered textbook pages/contact sheets are local inspection aids, not app assets.
docs/graphics-review/
/theory-and-knowledge/knowledge/**/*.pdf
*.py[cod]
__pycache__/
.env
# Local Firebase config, credentials, emulator data and admin before-images.
**/google-services*.json
**/google-services*.tmp
!**/google-services.template.json
**/*service-account*.json
**/*serviceAccount*.json
application_default_credentials.json
# Google CLI credentials belong in the Windows user profile, never in Git.
credentials.db
access_tokens.db
legacy_credentials/
.config/gcloud/
/.gcloud/
.local/
.firebase/
node_modules/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
# Keep environment values local; commit only the placeholder template.
.env.*
!.env.example
# Firebase client config is public by design, but kept local to avoid project mixups.
google-services.json
GoogleService-Info.plist
# Private signing/admin credentials must never enter source or build handoffs.
*.keystore
*.jks
*.p12
service-account*.json
*-firebase-adminsdk-*.json
/secrets/
# Local native skill-discovery aliases; author only .agents/skills/.
/.claude/skills/
/.github/skills/
# Local build, interpreter and editor state.
.gradle/
.kotlin/
build/
.venv/
.idea/
/.vscode/
/local.properties
.cxx/
.externalNativeBuild/
# Standalone Android build outputs stay local.
*.apk
*.aab
*-debug.log
# PhysiApp_installer.zip stays tracked at the root for the owner's workflow.